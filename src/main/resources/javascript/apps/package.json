{
    "name": "@jahia/SharedURLGenerator",
    "version": "2.2.2-SNAPSHOT",
    "scripts": {
        "build": "yarn lint:fix && yarn webpack",
        "lint": "eslint --ext js,jsx,json .",
        "webpack": "node --max_old_space_size=2048 ./node_modules/webpack/bin/webpack.js",
        "build:analyze": "yarn build --analyze",
        "build:production": "yarn build --mode=production",
        "build:production-analyze": "yarn build:production --analyze",
        "watch": "yarn webpack --watch",
        "clean": "rimraf *.log src/main/resources/javascript/apps",
        "clean:all": "yarn clean && rimraf node_modules node",
        "lint:fix": "eslint --ext js,jsx,json --fix .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "description": "Jahia Shared URL Generator Editor",
    "main": "index.js",
    "repository": "git@github.com:Jahia/content-sharing.git",
    "author": "Herve Duchesne <hduchesne@jahia.com>",
    "license": "SEE LICENSE IN LICENSE.md FILE",
    "jahia": {
        "remotes": {
            "jahia": "javascript/apps/remoteEntry.js"
        }
    },
    "dependencies": {
        "@apollo/client": "^3.11.8",
        "@jahia/moonstone": "^2.7.4",
        "@jahia/ui-extender": "^1.0.0",
        "i18next": "^19.7.0",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "11.7.3",
        "react-redux": "^8.1.3"
    },
    "devDependencies": {
        "@babel/compat-data": "^7.9.0",
        "@babel/core": "^7.13.16",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-runtime": "^7.19.6",
        "@babel/preset-env": "^7.25.3",
        "@babel/preset-react": "^7.24.7",
        "@jahia/eslint-config": "^2.1.2",
        "@jahia/webpack-config": "^1.1.0",
        "babel-loader": "^8.1.0",
        "babel-plugin-lodash": "^3.3.4",
        "case-sensitive-paths-webpack-plugin": "^2.3.0",
        "clean-webpack-plugin": "^3.0.0",
        "copy-webpack-plugin": "^6.4.1",
        "css-loader": "^7.1.2",
        "eslint": "8.57.0",
        "eslint-plugin-jest": "^27.9.0",
        "eslint-plugin-json": "^3.1.0",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "file-loader": "^6.1.1",
        "style-loader": "^1.1.3",
        "vitest": "^2.1.9",
        "webpack": "^5.88.2",
        "webpack-bundle-analyzer": "^4.2.0",
        "webpack-cli": "^4.2.0"
